NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Product ID: https://dashboard.stripe.com/products
STRIPE_PRO_PRODUCT_ID=prod_...
# Webhook secret: https://dashboard.stripe.com/webhooks → your endpoint → Signing secret
